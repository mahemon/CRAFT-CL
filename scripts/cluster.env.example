# Cluster settings read by scripts/run_craft.sh, run_streams.sh and eval_later.sh.
# Copy this file to scripts/cluster.env and fill in your own values; every line is optional.
# Anything set on the command line (e.g. PARTITION=gpu) wins over these.
PARTITION="${PARTITION:-gpu}"                  # SLURM partition
ACCOUNT="${ACCOUNT:-}"                         # SLURM account, if your cluster needs one
SHORT_PARTITIONS="${SHORT_PARTITIONS:-}"       # partitions with a shorter time limit (use each model's shorter wall time)
VENV_ACTIVATE="${VENV_ACTIVATE:-}"             # e.g. $HOME/venvs/craft/bin/activate
CUDA_MODULE="${CUDA_MODULE:-}"                 # e.g. cuda/12.4
EXCLUDE_NODES="${EXCLUDE_NODES:-}"             # nodes to avoid, e.g. node12,node13
